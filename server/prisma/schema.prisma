generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  CITIZEN
  MAYOR
}

enum ItemType {
  SEED
  RAW
  INGREDIENT
  MEAL
  EQUIPMENT
}

enum WorkType {
  FARM
  COOK
  MINE
  SMELT
  EXTRACT
  REFINE
  GATHER
  SEW
  FORAGE
  BREW
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum EquipmentSlot {
  HEAD
  UPPER_BODY
  LOWER_BODY
  ARM
  GLOVE
  SHOE
}

enum EquipmentRarity {
  NORMAL
  RARE
  EPIC
  LEGENDARY
}

enum JobSlot {
  first_job
  secondary_job
}

enum SkillEffectType {
  TIME_QUEUE
  CRAFT_COST
  OUTPUT_BONUS
  MARKET_BONUS
  DROP_RATE_BONUS
  ENERGY_EFFICIENCY
  CUSTOM
}

// ─── User ────────────────────────────────────────────────

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password_hash     String
  role              UserRole @default(CITIZEN)
  money             Int      @default(5000)
  hunger            Float    @default(2400)
  hunger_updated_at DateTime @default(now())
  satiety_buff      Float    @default(0)
  buff_expires_at   DateTime?
  city_key          String?
  city_selected_at  DateTime?
  first_job_level   Int      @default(0) // 0 = not unlocked, 1+ = active level
  first_job_skill_level Int  @default(0)
  first_job_exp     Int      @default(0)
  secondary_job_level Int    @default(0)
  secondary_job_skill_level Int @default(0)
  secondary_job_exp Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  inventory      InventorySlot[]
  work_orders    WorkOrder[]
  sell_listings  MarketListing[]   @relation("seller")
  buy_history    MarketListing[]   @relation("buyer")
  recipe_unlocks UserRecipeUnlock[]
  equipments     UserEquipment[]
  job_progress   UserJobProgress[]
  skill_progress UserSkillProgress[]
  daily_quests   PlayerDailyQuest[]

  @@map("users")
}

// ─── Item Catalog ────────────────────────────────────────

model Item {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  type            ItemType
  equipment_slot  EquipmentSlot?
  effect_key      String?
  effect_value    Float?
  effect_value2   Float?
  buy_price       Int? // NPC shop price (null = not buyable)
  sell_price      Int? // NPC sell price (null = not sellable to NPC)
  kcal            Int? // Kcal restored when eaten
  buff_pct        Float? // Hunger decay slowdown % (e.g. 0.05 = 5%)
  buff_mins       Int? // Buff duration in real minutes
  max_stack       Int            @default(1)
  grow_mins       Int? // Growth time for seeds (real minutes)
  yield_item_id   Int? // Item produced when harvested
  yield_qty       Int? // Quantity produced
  exp_value       Float          @default(1.0) // Base EXP multiplier for market sales
  icon            String         @default("box")

  yield_item         Item?                @relation("yield", fields: [yield_item_id], references: [id])
  yielded_from       Item[]               @relation("yield")
  inventory_slots    InventorySlot[]
  work_orders        WorkOrder[]
  recipe_outputs     Recipe[]             @relation("recipeOutput")
  recipe_ingredients RecipeIngredient[]
  market_listings    MarketListing[]
  equipped_on        UserEquipment[]
  quest_requirements DailyQuestRequirement[]

  @@map("items")
}

// ─── Recipes ─────────────────────────────────────────────

model Recipe {
  id             Int    @id @default(autoincrement())
  name           String @unique
  output_item_id Int
  output_qty     Int    @default(1)
  cook_mins      Int    @default(5) // Cooking time in real minutes
  unlock_price   Int    @default(300)

  output_item Item               @relation("recipeOutput", fields: [output_item_id], references: [id])
  ingredients RecipeIngredient[]
  unlocked_by UserRecipeUnlock[]

  @@map("recipes")
}

model RecipeIngredient {
  id        Int @id @default(autoincrement())
  recipe_id Int
  item_id   Int
  quantity  Int @default(1)

  recipe Recipe @relation(fields: [recipe_id], references: [id])
  item   Item   @relation(fields: [item_id], references: [id])

  @@unique([recipe_id, item_id])
  @@map("recipe_ingredients")
}

model UserRecipeUnlock {
  id          Int      @id @default(autoincrement())
  user_id     Int
  recipe_id   Int
  unlocked_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  recipe Recipe @relation(fields: [recipe_id], references: [id])

  @@unique([user_id, recipe_id])
  @@map("user_recipe_unlocks")
}

// ─── Inventory ───────────────────────────────────────────

model InventorySlot {
  id       Int @id @default(autoincrement())
  user_id  Int
  slot     Int // 0–15
  item_id  Int?
  quantity Int @default(0)
  equipment_rarity EquipmentRarity?
  equipment_durability Float?
  enchant_level  Int     @default(0)
  special_stat_1 String?
  special_stat_2 String?
  special_stat_3 String?
  special_stat_4 String?

  user User  @relation(fields: [user_id], references: [id])
  item Item? @relation(fields: [item_id], references: [id])

  @@unique([user_id, slot])
  @@map("inventory_slots")
}

model UserEquipment {
  id         Int           @id @default(autoincrement())
  user_id    Int
  slot       EquipmentSlot
  item_id    Int?
  item_rarity EquipmentRarity?
  durability  Float        @default(100)
  durability_updated_at DateTime @default(now())
  updated_at DateTime      @updatedAt
  enchant_level  Int     @default(0)
  special_stat_1 String?
  special_stat_2 String?
  special_stat_3 String?
  special_stat_4 String?

  user User  @relation(fields: [user_id], references: [id])
  item Item? @relation(fields: [item_id], references: [id])

  @@unique([user_id, slot])
  @@map("user_equipments")
}

// ─── Work Orders ─────────────────────────────────────────

model WorkOrder {
  id           Int      @id @default(autoincrement())
  user_id      Int
  type         WorkType
  item_id      Int // The seed/recipe item being worked
  recipe_id    Int? // Recipe ID if cooking
  output_rarity EquipmentRarity?
  quantity     Int      @default(1)
  started_at   DateTime @default(now())
  completes_at DateTime
  paused_at    DateTime?
  collected    Boolean  @default(false)

  user User @relation(fields: [user_id], references: [id])
  item Item @relation(fields: [item_id], references: [id])

  @@map("work_orders")
}

// ─── Market ──────────────────────────────────────────────

model MarketListing {
  id         Int           @id @default(autoincrement())
  seller_id  Int
  buyer_id   Int?
  item_id    Int
  quantity   Int
  price      Int           // Total price
  equipment_rarity EquipmentRarity?
  status     ListingStatus @default(ACTIVE)
  created_at DateTime      @default(now())
  sold_at    DateTime?
  enchant_level  Int     @default(0)
  special_stat_1 String?
  special_stat_2 String?
  special_stat_3 String?
  special_stat_4 String?

  seller User  @relation("seller", fields: [seller_id], references: [id])
  buyer  User? @relation("buyer", fields: [buyer_id], references: [id])
  item   Item  @relation(fields: [item_id], references: [id])

  @@map("market_listings")
}

// ─── Dynamic Occupation Progression ─────────────────────

model OccupationCatalog {
  occupation_key String @id
  city_key       String
  job_slot       JobSlot
  display_name   String
  workspace_mode String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  skill_branches OccupationSkillBranchCatalog[]
  job_progress   UserJobProgress[]
  skill_progress UserSkillProgress[]

  @@unique([city_key, job_slot])
  @@map("occupation_catalog")
}

model OccupationSkillBranchCatalog {
  id                 Int @id @default(autoincrement())
  occupation_key     String
  branch_slot        Int
  branch_key         String
  branch_name        String
  effect_type        SkillEffectType
  max_level          Int @default(5)
  effect_config_json Json
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  occupation OccupationCatalog @relation(fields: [occupation_key], references: [occupation_key])

  @@unique([occupation_key, branch_slot])
  @@unique([occupation_key, branch_key])
  @@map("occupation_skill_branch_catalog")
}

model UserJobProgress {
  id             Int @id @default(autoincrement())
  user_id        Int
  job_slot       JobSlot
  occupation_key String
  level          Int @default(1)
  exp            Int @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user       User              @relation(fields: [user_id], references: [id])
  occupation OccupationCatalog @relation(fields: [occupation_key], references: [occupation_key])

  @@unique([user_id, job_slot])
  @@map("user_job_progress")
}

model UserSkillProgress {
  id             Int @id @default(autoincrement())
  user_id        Int
  job_slot       JobSlot
  occupation_key String
  branch_key     String
  level          Int @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user       User              @relation(fields: [user_id], references: [id])
  occupation OccupationCatalog @relation(fields: [occupation_key], references: [occupation_key])

  @@unique([user_id, job_slot, branch_key])
  @@map("user_skill_progress")
}

// ─── Dynamic Workspace Rules ───────────────────────────

model CityWorkspaceRule {
  id               Int      @id @default(autoincrement())
  city_key         String   @db.VarChar(32)
  job_slot         JobSlot
  work_type        WorkType
  workspace_mode   String   @default("") @db.VarChar(32)
  matcher_type     String   @db.VarChar(32)
  matcher_value    String   @default("") @db.VarChar(96)
  required_item_name String @db.VarChar(96)
  must_be_equipped Boolean  @default(true)
  error_code       String   @default("WORKSPACE_REQUIREMENT_FAILED") @db.VarChar(64)
  error_message    String   @db.VarChar(255)
  is_enabled       Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([city_key, job_slot, work_type, workspace_mode, matcher_type, matcher_value, required_item_name])
  @@index([city_key, job_slot, work_type, is_enabled])
  @@map("city_workspace_rules")
}

// ─── Runtime SQL-backed tables ─────────────────────────

model GameSetting {
  setting_key   String   @id
  setting_value String
  updated_at    DateTime @updatedAt

  @@map("game_settings")
}

model CityState {
  city_key               String   @id
  display_name           String
  treasury               BigInt   @default(0)
  tier                   Int      @default(1)
  domestic_trade_tax_bp  Int      @default(300)
  export_tax_bp          Int      @default(300)
  import_tax_bp          Int      @default(300)
  mayor_user_id          Int?
  cycle_started_at       DateTime
  cycle_ends_at          DateTime
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("city_states")
}

model UserCityTransferCycle {
  user_id         Int
  cycle_id        Int
  target_city_key String
  created_at      DateTime @default(now())

  @@id([user_id, cycle_id])
  @@map("user_city_transfer_cycles")
}

model CityMayorVote {
  city_key          String
  cycle_id          Int
  voter_user_id     Int
  candidate_user_id Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@id([city_key, cycle_id, voter_user_id])
  @@index([city_key, cycle_id, candidate_user_id], map: "idx_city_mayor_votes_candidate")
  @@map("city_mayor_votes")
}

model CityShopItemRule {
  id            Int      @id @default(autoincrement())
  city_key      String
  matcher_type  String
  matcher_value String
  required_role String   @default("ANY")
  is_enabled    Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([city_key, matcher_type, matcher_value, required_role], map: "uq_city_shop_item_rule")
  @@map("city_shop_item_rules")
}

model CityShopRecipeRule {
  id            Int      @id @default(autoincrement())
  city_key      String
  matcher_type  String
  matcher_value String
  required_role String   @default("ANY")
  is_enabled    Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([city_key, matcher_type, matcher_value, required_role], map: "uq_city_shop_recipe_rule")
  @@map("city_shop_recipe_rules")
}

// ─── Daily Quests ───────────────────────────────────────

model DailyQuestTemplate {
  id             Int      @id @default(autoincrement())
  city_key       String   @db.VarChar(32)
  title          String   @db.VarChar(160)
  description    String   @db.VarChar(500)
  reward_credits Int
  reward_exp     Int
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  requirements  DailyQuestRequirement[]
  player_quests PlayerDailyQuest[]

  @@index([city_key])
  @@map("daily_quest_templates")
}

model DailyQuestRequirement {
  id          Int @id @default(autoincrement())
  template_id Int
  item_id     Int
  quantity    Int @default(1)

  template DailyQuestTemplate @relation(fields: [template_id], references: [id])
  item     Item               @relation(fields: [item_id], references: [id])

  @@map("daily_quest_requirements")
}

model PlayerDailyQuest {
  id           Int       @id @default(autoincrement())
  user_id      Int
  template_id  Int
  quest_date   DateTime  // UTC midnight of the quest day
  completed    Boolean   @default(false)
  completed_at DateTime?
  created_at   DateTime  @default(now())

  user     User               @relation(fields: [user_id], references: [id])
  template DailyQuestTemplate @relation(fields: [template_id], references: [id])

  @@unique([user_id, template_id, quest_date])
  @@index([user_id, quest_date])
  @@map("player_daily_quests")
}
